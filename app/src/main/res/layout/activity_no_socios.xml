<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Pantalla Gestión de No Socios -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo del club -->
        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/logo_club"
            android:layout_marginBottom="16dp" />

        <!-- Título principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión de No Socios"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Botón Registrar No Socio -->
        <Button
            android:id="@+id/btnRegistrarNoSocio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar No Socio"
            android:textColor="@android:color/white"
            android:background="@color/Material_Purple"
            android:layout_marginBottom="12dp" />

        <!-- Botón Modificar No Socio -->
        <Button
            android:id="@+id/btnModificarNoSocio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modificar No Socio"
            android:textColor="@android:color/white"
            android:background="@color/Material_Purple"
            android:layout_marginBottom="12dp" />

        <!-- Botón Listado de No Socios -->
        <Button
            android:id="@+id/btnListadoNoSocios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listado de No Socios"
            android:textColor="@android:color/white"
            android:background="@color/Material_Purple" />

    </LinearLayout>
</ScrollView>
