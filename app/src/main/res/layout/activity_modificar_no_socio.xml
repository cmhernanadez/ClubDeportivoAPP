<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/logo_club"
            android:layout_marginBottom="16dp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modificar No Socio"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/etDniModificar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="DNI de la Persona"
            android:inputType="number"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/etNuevoTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nuevo Teléfono (ej: 1122334455)"
            android:inputType="phone"
            android:layout_marginBottom="24dp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <CheckBox
            android:id="@+id/cbFichaModificar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Tiene Ficha Médica al día?"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnConfirmarModificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar Modificación"
            android:textSize="18sp"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>